  "StaticPage": {
    "about": {
      "title": "About us",
      "sections": [
        {
          "heading": "The UzChess platform",
          "body": "UzChess is an online platform built to develop chess in Uzbekistan. Here you can track the player ranking, take chess courses, buy books from the library, and watch live game broadcasts."
        },
        {
          "heading": "Our mission",
          "body": "Our mission is to popularize chess among young people and grow the national chess school by offering quality learning materials and a transparent ranking system for players of every level."
        },
        {
          "heading": "What we offer",
          "body": "Courses with video lessons and interactive exercises, a library of chess books, a player ranking, the latest news, and live game broadcasts — all in one platform."
        }
      ]
    },
    "terms": {
      "title": "Terms of use",
      "sections": [
        {
          "heading": "General provisions",
          "body": "By using the UzChess platform you agree to these terms. Use the platform only for lawful purposes and respect the rights of other users."
        },
        {
          "heading": "Your account",
          "body": "The information you provide when registering must be accurate. You are fully responsible for keeping your account secure and for how it's used."
        },
        {
          "heading": "Payments and orders",
          "body": "Once payment is completed, courses and books become available in the relevant section immediately. Because these are digital goods, purchased courses and books are non-refundable unless required otherwise by law."
        },
        {
          "heading": "Intellectual property",
          "body": "All video lessons, text, images, and other materials on the platform belong to UzChess or its content rights holders; copying or distributing them without permission is prohibited."
        },
        {
          "heading": "Limitation of liability",
          "body": "UzChess works to keep the platform running smoothly and accurately, but is not liable for technical failures or interruptions in third-party services."
        }
      ]
    },
    "cookiePolicy": {
      "title": "Cookie policy",
      "sections": [
        {
          "heading": "What cookies are",
          "body": "A cookie is a small text file the site stores in your browser to help it work correctly and conveniently."
        },
        {
          "heading": "How we use cookies",
          "body": "UzChess uses cookies to keep you signed in, remember your language and other preferences, and collect usage statistics for the site."
        },
        {
          "heading": "Managing cookies",
          "body": "You can block or delete cookies at any time in your browser settings, though some site features may not work correctly as a result."
        }
      ]
    }
  },
