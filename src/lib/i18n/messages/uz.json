  "StaticPage": {
    "about": {
      "title": "Biz haqimizda",
      "sections": [
        {
          "heading": "UzChess platformasi",
          "body": "UzChess — O'zbekistonda shaxmat sportini rivojlantirish uchun yaratilgan onlayn platforma. Bu yerda siz o'yinchilar reytingini kuzatishingiz, shaxmat kurslarini o'rganishingiz, kutubxonadan kitoblar sotib olishingiz va jonli translyatsiyalarni tomosha qilishingiz mumkin."
        },
        {
          "heading": "Bizning maqsadimiz",
          "body": "Har qanday darajadagi o'yinchi uchun sifatli ta'lim materiallari va shaffof reyting tizimini taqdim etish orqali shaxmatni yoshlar orasida ommalashtirish va milliy shaxmat maktabini rivojlantirish bizning asosiy maqsadimizdir."
        },
        {
          "heading": "Nima taklif qilamiz",
          "body": "Video darslar va interaktiv mashqlardan iborat kurslar, shaxmat bo'yicha kitoblar kutubxonasi, o'yinchilar reytingi, so'nggi yangiliklar va jonli o'yinlar translyatsiyasi — barchasi bitta platformada."
        }
      ]
    },
    "terms": {
      "title": "Foydalanish qoidalari",
      "sections": [
        {
          "heading": "Umumiy qoidalar",
          "body": "UzChess platformasidan foydalanish orqali siz ushbu qoidalarga rozilik bildirasiz. Platformadan faqat qonuniy maqsadlarda va boshqa foydalanuvchilar huquqlarini hurmat qilgan holda foydalaning."
        },
        {
          "heading": "Hisob qaydnomasi",
          "body": "Ro'yxatdan o'tishda ko'rsatilgan ma'lumotlar aniq bo'lishi kerak. Hisobingiz xavfsizligi va undan foydalanish uchun to'liq javobgarlik foydalanuvchining o'zida bo'ladi."
        },
        {
          "heading": "To'lovlar va buyurtmalar",
          "body": "Kurslar va kitoblar uchun to'lovlar amalga oshirilgandan so'ng, ular tegishli bo'limlarda darhol mavjud bo'ladi. Raqamli mahsulotlar tabiatiga ko'ra, sotib olingan kurs va kitoblar qaytarib berilmaydi, agar qonun hujjatlarida boshqacha tartib nazarda tutilmagan bo'lsa."
        },
        {
          "heading": "Intellektual mulk",
          "body": "Platformadagi barcha video darslar, matnlar, rasmlar va boshqa materiallar UzChess yoki mualliflik huquqi egalariga tegishli bo'lib, ruxsatsiz ko'chirish yoki tarqatish taqiqlanadi."
        },
        {
          "heading": "Javobgarlikni cheklash",
          "body": "UzChess platforma orqali taqdim etilgan ma'lumotlarning uzluksizligi va xatolardan holi bo'lishi uchun harakat qiladi, biroq texnik nosozliklar yoki uchinchi tomon xizmatlaridagi uzilishlar uchun javobgar emas."
        }
      ]
    },
    "cookiePolicy": {
      "title": "Cookie fayllari siyosati",
      "sections": [
        {
          "heading": "Cookie fayli nima",
          "body": "Cookie — bu sayt tomonidan brauzeringizga saqlanadigan kichik matn fayli bo'lib, saytning to'g'ri va qulay ishlashini ta'minlashga yordam beradi."
        },
        {
          "heading": "Biz cookie fayllaridan qanday foydalanamiz",
          "body": "UzChess cookie fayllaridan tizimga kirish sessiyasini saqlash, til va boshqa sozlamalaringizni eslab qolish hamda saytdan foydalanish statistikasini yig'ish uchun foydalanadi."
        },
        {
          "heading": "Cookie fayllarini boshqarish",
          "body": "Siz brauzeringiz sozlamalari orqali cookie fayllarini istalgan vaqtda bloklashingiz yoki o'chirib tashlashingiz mumkin, biroq bu holda saytning ba'zi funksiyalari to'liq ishlamasligi mumkin."
        }
      ]
    }
  },
